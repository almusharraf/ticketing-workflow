PORT=4000

# SQLite file path for persisted travel requests. Left blank, defaults to
# backend/data/travel.db. Running multiple local instances against the same
# path shares data between them - set a different DB_PATH per instance for
# isolated parallel dev/test.
DB_PATH=

# Duffel API - https://duffel.com/docs
# Use a duffel_test_ prefixed key for the sandbox, duffel_live_ for production
# This is the only provider actually booked against - all bookings go through
# Duffel regardless of which source below shows the cheapest comparison price.
DUFFEL_API_KEY=your_duffel_api_key
DUFFEL_API_VERSION=v2

# --- Comparison-only sources (optional) ---
# None of these are required. Any left blank simply drops out of the search
# results silently - the app works fine on Duffel alone.

# Kiwi.com Tequila API - invitation-only for new partners as of 2026.
# https://tequila.kiwi.com
KIWI_API_KEY=

# Skyscanner Partner "Flights Live Prices" API - requires partner approval.
# https://developers.skyscanner.net/api/flights-live-pricing
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=UK
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_CURRENCY=GBP

# Travelpayouts Data API - self-serve signup, cached (not live) fares.
# https://travelpayouts.com
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Amadeus Self-Service Flight Offers Search - self-serve signup today, but
# Amadeus is sunsetting this tier 2026-07-17. Fine as a stopgap, not a
# long-term dependency. https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Post-booking flight status tracking (optional) ---
# AviationStack - real-time flight status/delay/gate data for flights already
# booked via Duffel. This is a schedule/status API, not a fares API, so it
# never affects search results. Left blank, the status panel just shows
# nothing. https://aviationstack.com
AVIATION_STACK_API_KEY=

# --- Email notifications (optional) ---
# Gmail address + an App Password (not your normal password - requires 2FA
# enabled on the account, generate one at myaccount.google.com/apppasswords).
# Left blank, sendEmail() just logs a warning and skips - notifications are
# best-effort, never a dependency for booking/cancellation/approval to work.
# SMTP_SECURE=false uses STARTTLS on port 587 (SMTP_SECURE=true would be port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
