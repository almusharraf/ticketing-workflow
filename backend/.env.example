PORT=4000

# Duffel API - https://duffel.com/docs
# Use a duffel_test_ prefixed key for the sandbox, duffel_live_ for production
# This is the only provider actually booked against - all bookings go through
# Duffel regardless of which source below shows the cheapest comparison price.
DUFFEL_API_KEY=your_duffel_api_key
DUFFEL_API_VERSION=v2

# --- Comparison-only sources (optional) ---
# None of these are required. Any left blank simply drops out of the search
# results silently - the app works fine on Duffel alone.

# Kiwi.com Tequila API - invitation-only for new partners as of 2026.
# https://tequila.kiwi.com
KIWI_API_KEY=

# Skyscanner Partner "Flights Live Prices" API - requires partner approval.
# https://developers.skyscanner.net/api/flights-live-pricing
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=UK
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_CURRENCY=GBP

# Travelpayouts Data API - self-serve signup, cached (not live) fares.
# https://travelpayouts.com
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Amadeus Self-Service Flight Offers Search - self-serve signup today, but
# Amadeus is sunsetting this tier 2026-07-17. Fine as a stopgap, not a
# long-term dependency. https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
